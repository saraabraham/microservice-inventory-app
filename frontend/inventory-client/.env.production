# In Kubernetes, nginx reverse-proxies /api/ → inventory-api and /api/stats → stats-service
# so we use relative paths and the browser never needs to know cluster-internal hostnames.
REACT_APP_API_URL=/api
REACT_APP_STATS_URL=/api/stats
DISABLE_ESLINT_PLUGIN=true
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false
